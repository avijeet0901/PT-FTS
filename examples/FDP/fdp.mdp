;; --------------------------------------------------------
;; Input MDP file for Phenylalanine-dipeptide in Vacuum Simulation
;; ---------------------------------------------------------

integrator          = md
dt                  = 0.002
nsteps              = 500000000

; Output
nstlog              = 1000
nstenergy           = 1000
nstxout             = 0
nstvout             = 0
nstfout             = 0
nstxtcout           = 1000
xtc-precision       = 1000
xtc-grps            = system

; Neighbor searching
cutoff-scheme       = Verlet
nstlist             = 20

pbc                 = xyz

coulombtype         = Cut-off
rcoulomb            = 2.0
vdwtype             = Cut-off
rvdw                = 2.0

constraints         = h-bonds
constraint_algorithm= lincs

tcoupl              = v-rescale
tc-grps             = system
tau_t               = 1.0
ref_t               = 272

pcoupl              = no

comm_mode           = linear
nstcomm             = 100

gen_vel             = yes
gen_temp            = 272
gen_seed            = 1536


