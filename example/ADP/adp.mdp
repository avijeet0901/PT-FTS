;; --------------------------------------------------------
;; Input MDP file for Alanine-dipeptide in Vacuum Simulation
;; ---------------------------------------------------------
 
integrator          =  md 
nsteps              =  5000000
dt                  =  0.002

comm_mode           =  Angular 
nstcomm             =  1000

nstlog                   = 5000
nstenergy                = 5000
nstxout                  = 500 
nstvout                  = 0  
nstfout                  = 0
nstxtcout                = 0 
xtc-precision            = 0
xtc-grps                 = protein

cutoff-scheme       = group
nstlist             = 0 
ns_type             = simple 
pbc                 = no 
rlist               = 0.0
periodic_molecules  = no 

rcoulomb            = 0.0
coulombtype         = Cut-off 

vdw-type            = Cut-off 
rvdw                = 0.0 

constraints              = all-bonds 
constraint-algorithm     = lincs
lincs_iter               = 4

Tcoupl              = v-rescale 
tc_grps             = system 
tau_t               = 0.1
ref_t               = 272.000 

Pcoupl              =  no

gen_vel             = yes 
gen_temp            = 272.000 
gen_seed            = 1536 
