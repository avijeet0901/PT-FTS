# Defining the CVs
ene: ENERGY
phi: TORSION ATOMS=5,7,9,25 
psi: TORSION ATOMS=7,9,25,27
chi1:  TORSION ATOMS=7,9,11,14
chi2:  TORSION ATOMS=9,11,14,15

# Applying restraint on a selected CV
restraint-XXX: RESTRAINT ARG=XXX KAPPA=80 AT=XXX

# printing the outout COLVAR file
PRINT STRIDE=10 ARG=phi,psi,....,ene,restraint-XXX.bias,restraint-XXX.force FILE=COLVAR 

